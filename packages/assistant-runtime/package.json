{
  "name": "@wenchuantech/assistant-runtime",
  "version": "0.1.0",
  "description": "Framework-neutral Wenchuan assistant runtime for Mobile, Web, and Electron",
  "author": "Beijing Wenchuan Network Technology Co., Ltd.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "pnpm --filter @wenchuantech/assistant-protocol build && vitest run"
  },
  "dependencies": {
    "@wenchuantech/assistant-protocol": "workspace:*"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
