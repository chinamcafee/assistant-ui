  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/chinamcafee/assistant-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinamcafee/assistant-ui.git",
    "directory": "packages/assistant-runtime"
  },
  "bugs": {
    "url": "https://github.com/chinamcafee/assistant-ui/issues"
  }
}
